# ==========================================
# BITGET API CREDENTIALS
# ==========================================
# Get these from Bitget -> API Management -> Create API
BITGET_API_KEY=your_bitget_api_key_here
BITGET_SECRET=your_bitget_secret_here
BITGET_PASSPHRASE=your_bitget_api_passphrase_here

# Set to true for Bitget Testnet (Demo Trading), false for Real Trading
USE_TESTNET=false

# ==========================================
# WEBHOOK SECURITY
# ==========================================
# Set a custom secret passphrase that TradingView must include in alert payloads
WEBHOOK_PASSPHRASE=my_super_secret_passphrase_123

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=8000
HOST=0.0.0.0
